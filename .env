# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
# To use real AI generation, replace 'your_api_key_here' with your actual OpenAI API Key starting with 'sk-'.
OPENAI_API_KEY=your_api_key_here

# Optional: Call type - "support" or "sales" (default: support)
CALL_TYPE=support

# Mock Mode Configuration
# If set to true, or if you keep a placeholder API key (one that doesn't start with 'sk-'), the application will run in offline mock mode.
# If set to false, it will attempt to use your real OpenAI API key.
USE_MOCK=false
